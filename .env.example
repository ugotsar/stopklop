# Clés publiques SDK RevenueCat. À renseigner localement dans .env, ou comme
# variables d'environnement EXPO_PUBLIC_* dans EAS pour chaque environnement.
# Ne jamais utiliser une clé RevenueCat de test dans une build de production.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_votre_cle_publique_ios
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_votre_cle_publique_android

# Créer un client OAuth distinct pour iOS et Android dans Google Cloud / Firebase.
# Sans clé de la plateforme, Google est désactivé au lieu de faire planter l'app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=votre_client_web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Uniquement pour Expo Go ou une build EAS Preview : donne accès à l'app sans
# achat afin de tester l'interface. Ne jamais mettre cette valeur à true dans
# l'environnement EAS production.
EXPO_PUBLIC_ALLOW_PAYWALL_BYPASS=false
