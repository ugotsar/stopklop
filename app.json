{
  "expo": {
    "name": "Stopklop",
    "slug": "stopklop",
    "scheme": "stopklop",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F1"
    },
    "ios": {
      "bundleIdentifier": "com.stopklop.app",
      "appleTeamId": "2CK95AV86W",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "buildNumber": "3",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Stopklop t'envoie des rappels pour noter tes cigarettes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.stopklop.app"
        ]
      }
    },
    "android": {
      "package": "com.stopklop.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#DDEBD6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#EAF4EC"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A7C59",
          "sounds": []
        }
      ],
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-font",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "StopklopBilan",
              "label": "Stopklop – Bilan",
              "description": "Ton bilan du jour et tes économies de la semaine",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.96875002607-cgdatuce0q3c8mn26p1ak3s3fqp0l9c6"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7ba05228-71fa-40e2-b17f-56b43250c363",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.stopklop.app.widget",
                  "targetName": "StopklopWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.stopklop.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "lepetitroi"
  }
}
