rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil utilisateur : chacun ne peut lire/écrire QUE son propre document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sous-collections (journées, etc.) : même règle
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Tout le reste est interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
